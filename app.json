{
  "expo": {
    "owner": "emmanueladejuwon2021-star",
    "name": "Apex Premed CBT",
    "slug": "premed-test-portal-android",
    "version": "1.0.0",
    "sdkVersion": "52.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F766E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.premed.portal.android"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F766E"
      },
      "package": "com.premed.portal.android",
      "versionCode": 4,
      "permissions": [
        "android.permission.VIBRATE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25",
            "useLegacyPackaging": true,
            "packagingOptions": {
              "pickFirst": ["**/libc++_shared.so", "**/libhermes.so"]
            }
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "966ef70b-7c9d-484d-b639-e27dbeca40c6"
      }
    }
  }
}
